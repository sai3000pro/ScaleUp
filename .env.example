# ScaleUp configuration.
#
# Copy to .env and edit. Every external integration is OFF by default and the
# whole product -- ingest, scoring, coaching, voice, quests -- runs and is
# tested that way, with no API keys and no network.
#
# To turn something on, set its selector and its key below, then restart the API
# (and the Celery worker, which reads this same file). Check what took effect:
#
#     cd backend
#     .\.venv\Scripts\python.exe ..\scripts\check_integrations.py
#
# or GET /api/health/providers, which reports the same thing over HTTP and never
# includes a secret's value.


# ── datastores (docker compose up -d) ─────────────────────────────────────────
# Host ports are deliberately non-default to avoid colliding with local installs.
DATABASE_URL=postgresql+asyncpg://la:la@localhost:5433/learn_anything
SYNC_DATABASE_URL=postgresql+psycopg://la:la@localhost:5433/learn_anything
CELERY_BROKER_URL=redis://localhost:6380/0
CELERY_RESULT_BACKEND=redis://localhost:6380/1
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=learnanything
CHROMA_HOST=localhost
CHROMA_PORT=8001


# ── auth ──────────────────────────────────────────────────────────────────────
# Generate a real one before anything leaves your laptop. Startup REFUSES this
# placeholder when DEPLOYED=true, because a leaked signing key lets anyone forge
# a token for any user and nothing about that failure is visible at runtime.
JWT_SECRET=change-me-before-you-use-this-anywhere-real
JWT_ALGORITHM=HS256
ACCESS_TOKEN_TTL_MINUTES=1440
REFRESH_TOKEN_TTL_DAYS=30

# Registers POST /api/auth/dev-login, which hands out a token with no password.
# With this off the route does not exist rather than merely refusing.
DEV_AUTH_ENABLED=true

FRONTEND_URL=http://localhost:3000
PASSWORD_RESET_TTL_MINUTES=30
OAUTH_STATE_TTL_MINUTES=10
OAUTH_EXCHANGE_CODE_TTL_MINUTES=2

# Turns the two development conveniences above into hard startup errors, and
# requires every integration marked "required when deployed" below.
DEPLOYED=false


# ══ INTEGRATIONS ══════════════════════════════════════════════════════════════
# Everything below is optional. Each has a working fallback.


# ── Anthropic / OpenAI / Gemini: language models ──────────────────────────────
# Off: a deterministic word-matching provider runs every prompt, schema, and
# ledger path for free. Graphs are real but less accurate; grading is by rubric
# overlap; the examiner echoes its deterministic floor.
LLM_PROVIDER=fake
# fake | anthropic | openai | gemini
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GEMINI_API_KEY=
# One key per workload lane, each falling back to GEMINI_API_KEY above. Drop
# separate keys in when you want the lanes to bill and rate-limit independently:
# compiling a curriculum is bursty and can exhaust a quota, and when it does, a
# learner mid-take should still hear their coach.
#   ingest = curriculum planning, extraction, merge, summaries
#   tutor  = drills, grading, examiner feedback, course Q&A, score composition
#   live   = the streaming coach cue
GEMINI_API_KEY_INGEST=
GEMINI_API_KEY_TUTOR=
GEMINI_API_KEY_LIVE=
# Google's OpenAI-compatible surface. Empty follows the provider default; set it
# to reach a proxy or to pin an API version.
GEMINI_BASE_URL=
# How long a learner waits on the model before the deterministic tree is served
# instead. Gemini answers 503 under load and takes its time doing it.
GEMINI_TIMEOUT_SECONDS=45
GEMINI_MAX_RETRIES=1

# Gemini is the only credentialed provider that streams over the role registry,
# so it is what makes the live coach speak from a model rather than from its
# deterministic floor.
#
# Availability is handled for you, and it is worth knowing what it does. Google's
# shared free tier answers 503 on its stronger aliases for minutes at a time, so
# each role names a fallback model too: an overloaded primary is re-attempted on
# the cheaper sibling, and if that is unreachable as well the call is served by
# the deterministic provider. A learner therefore gets a plainer question rather
# than a failed one. Which model actually answered is on every `llm_calls` row,
# so a week spent on the floor is a query, not a guess.

# ── Gemini Live API: real-time multimodal coach ───────────────────────────────
# A separate seam from the role registry above: bidirectional audio and text over
# Google's GenerativeService.BidiGenerateContent WebSocket, rather than a
# structured or streamed text completion. It reads the same GEMINI_API_KEY.
GEMINI_LIVE_MODEL=models/gemini-3.1-flash-live-preview
# Voices: Puck (crisp) | Charon (warm) | Kore (calm) | Fenrir (authoritative) | Aoede (bright)
GEMINI_LIVE_VOICE=Puck

# Embeddings. Anthropic has no embeddings endpoint, so a Claude-served
# deployment needs OpenAI or Gemini here; a Gemini-served one does not.
EMBEDDING_PROVIDER=fake
# fake | openai | gemini
EMBEDDING_MODEL=text-embedding-3-small
GEMINI_EMBEDDING_MODEL=gemini-embedding-001
EMBEDDING_DIMENSIONS=1536

# A ceiling per course, not per request: one textbook ingest is many calls.
# The fake providers estimate to $0, so the offline loop is always free.
COURSE_LLM_BUDGET_USD=5.00


# ── ElevenLabs: the examiner's voice ──────────────────────────────────────────
# Off: a deterministic silence WAV. Every response still carries `spoken_text`,
# so the browser speaks the feedback with its own voice and the loop is complete.
VOICE_PROVIDER=fake
# fake | elevenlabs
ELEVENLABS_API_KEY=
# Empty uses the provider default. NOTE: the voice id feeds the voice-artifact
# cache key, so changing it invalidates cached audio by design.
ELEVENLABS_VOICE_ID=
ELEVENLABS_MODEL_ID=eleven_multilingual_v2
# Flash is the low-latency model, which is the one that matters for live coaching.
ELEVENLABS_STREAMING_MODEL_ID=eleven_flash_v2_5


# ── n8n: macro-orchestration ──────────────────────────────────────────────────
# Two independent directions.
#
# INBOUND (n8n calls the app): session.completed, feedback.requested,
# daily-quests.refresh. Every request is HMAC-SHA256 signed over the exact body
# bytes as `X-Webhook-Signature: sha256=<hex>`. Off: the endpoints answer 503.
WEBHOOK_SECRET=
# Accepts UNSIGNED webhook calls. Local development only; startup refuses
# DEPLOYED=true with an empty WEBHOOK_SECRET, so this cannot become a bypass.
DEV_WEBHOOKS_ENABLED=false

# OUTBOUND (the app calls n8n) so a workflow can react to a finished take
# instead of polling. Empty means nothing is emitted at all, and no code path
# waits on it. Signed with WEBHOOK_SECRET above when one is set.
N8N_WEBHOOK_URL=
N8N_TIMEOUT_SECONDS=5


# ── Resend: password-reset email ──────────────────────────────────────────────
# Off: the reset link is logged instead of sent, which is what makes account
# recovery testable locally. Required when DEPLOYED=true.
EMAIL_PROVIDER=fake
# fake | resend
RESEND_API_KEY=
EMAIL_FROM=ScaleUp <noreply@example.com>


# ── Google OAuth: sign in with Google ─────────────────────────────────────────
# Off: email and password sign-in, always available. Configuring it enables it --
# there is no selector. Required when DEPLOYED=true.
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_OAUTH_REDIRECT_URI=http://localhost:8000/api/auth/google/callback


# ── Exa: web search for goal-to-curriculum ────────────────────────────────────
# Off: deterministic example results, so the propose/review/approve flow is
# demoable without a search bill. Approval is still required before any ingest.
RESEARCH_PROVIDER=fake
# fake | exa
EXA_API_KEY=
RESEARCH_MAX_RESULTS=8
RESEARCH_TIMEOUT_SECONDS=12


# ── Object storage ────────────────────────────────────────────────────────────
# Off: the local filesystem. Fine on one machine, ephemeral on a managed host --
# which is why `gcs` is required when DEPLOYED=true: the API and the worker must
# see the same bytes.
STORAGE_BACKEND=local
# local | gcs
GCS_BUCKET=
GCS_PREFIX=learn-anything/sources
UPLOAD_DIR=./uploads


# ── ingestion pipeline ────────────────────────────────────────────────────────
PIPELINE_VERSION=1
CHUNK_TOKENS=800
CHUNK_OVERLAP_TOKENS=120
EXTRACT_CHUNKS_PER_WINDOW=6
EMBED_BATCH_SIZE=64
# How many outline entries a document needs before its own table of contents is
# trusted as its structure. Below it, that document falls back to LLM extraction.
MIN_TOC_ENTRIES=4
# Split sections on the concept boundaries a book marks itself. OFF because it
# is measured: node granularity improves and prerequisite precision collapses.
# See docs/archive/textbook-product.md for the numbers.
SEGMENT_SECTIONS=false
# Empty follows the provider: deterministic captions with no key, model-written
# captions when one is configured. Set true/false to measure one against the other.
SUMMARISE_NODES=


# ── URL ingestion ─────────────────────────────────────────────────────────────
URL_FETCH_TIMEOUT_SECONDS=15
URL_FETCH_MAX_BYTES=10485760
URL_FETCH_MAX_REDIRECTS=3
# Turns OFF the SSRF address check. This is the switch that makes the cloud
# metadata endpoint reachable through the URL ingest form. Rejected at startup
# when DEPLOYED=true.
URL_FETCH_ALLOW_PRIVATE_HOSTS=false


# ── live coaching ─────────────────────────────────────────────────────────────
# A first token slower than this means the learner has started playing again, so
# the utterance is abandoned in favour of the deterministic sentence.
COACH_FIRST_TOKEN_TIMEOUT_SECONDS=1.5
COACH_UTTERANCE_TIMEOUT_SECONDS=6
COACH_TAKE_TTL_SECONDS=30
# How slowly the fake provider streams, so the incremental render path is
# actually exercised in development. CI sets this to 0.
FAKE_STREAM_DELAY_SECONDS=0.02


# ── misc ──────────────────────────────────────────────────────────────────────
LOG_LEVEL=INFO
# Renaming this logs every existing session out.
REFRESH_COOKIE_NAME=learn_anything_refresh
# Sent on outbound URL fetches so an operator can identify the traffic.
URL_FETCH_USER_AGENT=ScaleUp/0.1 (+https://github.com/; personal study tool)
# Loopback only, and a regex because Next.js silently moves to the next free
# port. Replace with an explicit origin list before deploying; startup refuses
# a loopback origin when DEPLOYED=true.
CORS_ORIGIN_REGEX=http://(localhost|127\.0\.0\.1)(:\d+)?


# ── frontend ──────────────────────────────────────────────────────────────────
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000

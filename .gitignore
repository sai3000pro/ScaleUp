# ── Python ────────────────────────────────────────────────────────────────
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/
.pytest_cache/
.ruff_cache/
.coverage
htmlcov/

# ── Node / Next.js ────────────────────────────────────────────────────────
node_modules/
.next/
out/
next-env.d.ts
*.tsbuildinfo

# ── Secrets & local state ─────────────────────────────────────────────────
.env
.env.local
.env.*.local

# Uploaded documents live on disk, keyed by content hash. Never commit them.
# Both locations: UPLOAD_DIR is configurable, and .env.example points it at the
# repo root rather than backend/.
uploads/
backend/uploads/

# ── Editors / OS ──────────────────────────────────────────────────────────
.DS_Store
Thumbs.db
.idea/
.vscode/*
!.vscode/extensions.json

# Agent worktrees: real git checkouts, never content of this repo.
.claude/worktrees/

# graphify's on-disk knowledge graph: an AST cache keyed by content hash,
# regenerated by the tool on demand. ~9 MB of derived data, not source.
graphify-out/

# Brownfield mapping scratch (sweep reports); regenerate with /map-codebase
.lid/

.vercel
.env*

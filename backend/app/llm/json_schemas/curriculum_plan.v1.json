{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": ["instrument", "instrument_title", "concepts", "edges"],
  "properties": {
    "instrument": {
      "type": "string",
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$",
      "maxLength": 40
    },
    "instrument_title": {"type": "string", "minLength": 2, "maxLength": 60},
    "concepts": {
      "type": "array",
      "minItems": 4,
      "maxItems": 24,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["slug"],
        "properties": {
          "from": {"type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"},
          "slug": {"type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$", "maxLength": 60},
          "title": {"type": "string", "minLength": 2, "maxLength": 120},
          "summary": {"type": "string", "minLength": 10, "maxLength": 400},
          "difficulty": {"type": "integer", "minimum": 1, "maximum": 5},
          "key_terms": {
            "type": "array",
            "items": {"type": "string", "minLength": 1, "maxLength": 40},
            "maxItems": 6
          }
        }
      }
    },
    "edges": {
      "type": "array",
      "maxItems": 60,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["prereq", "target"],
        "properties": {
          "prereq": {"type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"},
          "target": {"type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"},
          "confidence": {"type": "number", "minimum": 0, "maximum": 1},
          "rationale": {"type": "string", "maxLength": 200}
        }
      }
    }
  }
}

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "matched_skill_slugs": {
      "type": "array",
      "items": {"type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"},
      "maxItems": 24
    },
    "missing_capabilities": {
      "type": "array",
      "items": {"type": "string", "minLength": 2, "maxLength": 120},
      "maxItems": 12
    },
    "readiness": {
      "type": "number",
      "minimum": 0,
      "maximum": 1
    },
    "rationale": {
      "type": "string",
      "minLength": 20,
      "maxLength": 600
    }
  },
  "required": ["matched_skill_slugs", "missing_capabilities", "readiness", "rationale"]
}

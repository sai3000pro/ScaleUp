{
  "type": "object",
  "additionalProperties": false,
  "required": ["question_type", "question", "options", "correct_option_id", "accepted_answers", "code_language", "code_requirements", "rubric", "difficulty"],
  "properties": {
    "question_type": {
      "type": "string",
      "enum": ["short_answer", "mcq", "cloze", "code"]
    },
    "question": {
      "type": "string",
      "minLength": 15,
      "maxLength": 600
    },
    "options": {
      "type": "array",
      "maxItems": 4,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "text"],
        "properties": {
          "id": { "type": "string", "pattern": "^option-[a-z]$" },
          "text": { "type": "string", "minLength": 1, "maxLength": 300 }
        }
      }
    },
    "correct_option_id": {
      "type": ["string", "null"],
      "pattern": "^option-[a-z]$"
    },
    "accepted_answers": {
      "type": "array",
      "maxItems": 5,
      "items": { "type": "string", "minLength": 1, "maxLength": 120 }
    },
    "code_language": {
      "type": ["string", "null"],
      "maxLength": 32
    },
    "code_requirements": {
      "type": "array",
      "maxItems": 5,
      "items": { "type": "string", "minLength": 1, "maxLength": 120 }
    },
    "rubric": {
      "type": "array",
      "minItems": 1,
      "maxItems": 5,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "point", "weight"],
        "properties": {
          "id": { "type": "string", "pattern": "^kp[0-9]+$" },
          "point": { "type": "string", "minLength": 5, "maxLength": 300 },
          "weight": { "type": "number", "exclusiveMinimum": 0, "maximum": 1 }
        }
      }
    },
    "difficulty": { "type": "integer", "minimum": 1, "maximum": 5 }
  }
}

{
  "type": "object",
  "additionalProperties": false,
  "required": ["question", "rubric", "difficulty"],
  "properties": {
    "question": {
      "type": "string",
      "minLength": 15,
      "maxLength": 600,
      "description": "A short-answer question the learner can answer in two or three sentences."
    },
    "rubric": {
      "type": "array",
      "minItems": 1,
      "maxItems": 5,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "point", "weight"],
        "properties": {
          "id": { "type": "string", "pattern": "^kp[0-9]+$" },
          "point": {
            "type": "string",
            "minLength": 5,
            "maxLength": 300,
            "description": "One idea a correct answer must convey. Meaning, not wording."
          },
          "weight": { "type": "number", "exclusiveMinimum": 0, "maximum": 1 }
        }
      }
    },
    "difficulty": { "type": "integer", "minimum": 1, "maximum": 5 }
  }
}
